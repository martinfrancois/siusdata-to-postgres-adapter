{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "reviewers": [
    "martinfrancois"
  ],
  "rangeStrategy": "replace",
  "separateMinorPatch": true,
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true
    },
    {
      "groupName": "all remaining dependencies",
      "matchPackageNames": [
        "/.*/"
      ]
    },
    {
      "groupName": "Testing",
      "matchPackageNames": [
        "org.mockito{/,}**",
        "org.junit{/,}**",
        "org.testcontainers{/,}**",
        "com.github.stefanbirkner{/,}**",
        "org.awaitility{/,}**"
      ]
    }
  ]
}
