{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "reviewers": [
    "martinfrancois"
  ],
  "rangeStrategy": "replace",
  "separateMinorPatch": true,
  "packageRules": [
    {
      "matchUpdateTypes": [
        "patch", "pin", "digest"
      ],
      "automerge": true
    },
    {
      "groupName": "Testing",
      "matchPackageNames": [
        "org.mockito{/,}**",
        "org.junit{/,}**",
        "org.testcontainers{/,}**",
        "com.github.stefanbirkner{/,}**",
        "org.awaitility{/,}**"
      ]
    }
  ]
}
